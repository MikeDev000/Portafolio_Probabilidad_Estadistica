<?xml version="1.0" encoding="UTF-8"?>
<!--
  ╔══════════════════════════════════════════════════════════════╗
  ║  main-view.fxml  —  Layout del Dashboard principal           ║
  ║                                                              ║
  ║  Ruta: resources/com/estadistica/portafolio/fxml/            ║
  ║                                                              ║
  ║  PARA AGREGAR UN TEMA AL MENÚ:                               ║
  ║    1. Busca la sección "ZONA DE TEMAS"                       ║
  ║    2. Descomenta o duplica el bloque <Button>                ║
  ║    3. Cambia el fx:id, el onAction y el texto del Label      ║
  ╚══════════════════════════════════════════════════════════════╝
-->

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.portafolio_final.controller.MainController"
      spacing="0" minHeight="580">

    <!-- ╔══════════════════════════════════════╗ -->
    <!-- ║           SIDEBAR IZQUIERDO          ║ -->
    <!-- ╚══════════════════════════════════════╝ -->
    <VBox styleClass="sidebar" prefWidth="262" minWidth="262" maxWidth="262">

        <!-- Cabecera: Logo + nombre de la materia -->
        <VBox styleClass="sidebar-header" alignment="CENTER" spacing="5">
            <padding><Insets top="28" bottom="22" left="20" right="20"/></padding>
            <FontIcon iconLiteral="fas-chart-pie" iconSize="38" iconColor="#6c63ff"/>
            <Label text="Prob &amp; Estadística" styleClass="sidebar-title"/>
            <Label text="Conceptos clave" styleClass="sidebar-subtitle"/>
        </VBox>

        <Separator styleClass="sidebar-separator"/>

        <!-- ── Sección GENERAL ──────────────────────────── -->
        <VBox styleClass="nav-section" spacing="3">
            <padding><Insets top="16" bottom="6" left="14" right="14"/></padding>
            <Label text="GENERAL" styleClass="nav-section-label"/>

            <Button fx:id="btnInicio" styleClass="nav-button"
                    maxWidth="Infinity" onAction="#mostrarInicio">
                <graphic>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-home" iconSize="15" iconColor="#8b8fa8"/>
                        <Label text="Inicio" mouseTransparent="true"/>
                    </HBox>
                </graphic>
            </Button>
        </VBox>

        <!-- ── Sección TEMAS ────────────────────────────── -->
        <VBox styleClass="nav-section" spacing="3">
            <padding><Insets top="6" bottom="6" left="14" right="14"/></padding>
            <Label text="TEMAS" styleClass="nav-section-label"/>

            <!-- ╔══════════════════════════════════════════════╗
                 ║  ZONA DE TEMAS  ←  Agrega tus botones aquí  ║
                 ║  Duplica el bloque <Button> por cada tema    ║
                 ╚══════════════════════════════════════════════╝ -->

            <!-- TEMA 1: Probabilidad Clásica (ejemplo incluido) -->
            <Button fx:id="btnTema1" styleClass="nav-button"
                    maxWidth="Infinity" onAction="#abrirTema1">
                <graphic>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-dice" iconSize="15" iconColor="#8b8fa8"/>
                        <Label text="Prob. Clásica" mouseTransparent="true"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- TEMA 2 (plantilla comentada — descomenta y personaliza) -->
            <Button fx:id="btnTema2" styleClass="nav-button"
                    maxWidth="Infinity" onAction="#abrirTema2">
                <graphic>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-random" iconSize="15" iconColor="#8b8fa8"/>
                        <Label text="P1 Barajas" mouseTransparent="true"/>
                    </HBox>
                </graphic>
            </Button>


            <!-- TEMA 3 (plantilla comentada)
            <Button fx:id="btnTema3" styleClass="nav-button"
                    maxWidth="Infinity" onAction="#abrirTema3">
                <graphic>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-chart-bar" iconSize="15" iconColor="#8b8fa8"/>
                        <Label text="Estadística Desc." mouseTransparent="true"/>
                    </HBox>
                </graphic>
            </Button>
            -->

        </VBox>

        <!-- Separador flexible para empujar el footer hacia abajo -->
        <Region VBox.vgrow="ALWAYS"/>

        <!-- Footer: datos del alumno -->
        <VBox styleClass="sidebar-footer" spacing="0">
            <padding><Insets top="0" bottom="20" left="20" right="20"/></padding>
            <Separator styleClass="sidebar-separator" style="-fx-padding: 0 0 12 0;"/>
            <VBox spacing="3" style="-fx-padding: 14 0 0 0;">
                <Label text="Desarrollado por" styleClass="footer-label"/>
                <Label fx:id="lblNombreSidebar" text="..." styleClass="footer-value"/>
                <Label fx:id="lblGrupoSidebar"  text="..." styleClass="footer-group"/>
            </VBox>
        </VBox>

    </VBox><!-- fin sidebar -->


    <!-- ╔══════════════════════════════════════╗ -->
    <!-- ║         ÁREA DE CONTENIDO            ║ -->
    <!-- ╚══════════════════════════════════════╝ -->
    <ScrollPane fitToWidth="true" styleClass="content-scroll" HBox.hgrow="ALWAYS">
        <VBox styleClass="content-area" spacing="22">
            <padding><Insets top="36" bottom="40" left="40" right="40"/></padding>

            <!-- ── Encabezado de página ─────────────────── -->
            <VBox spacing="6">
                <Label text="Dashboard" styleClass="page-title"/>
                <Label text="Todos los temas de probabilidad y estadística al alcance de un click."
                       styleClass="page-subtitle" wrapText="true"/>
            </VBox>

            <!-- ── Tarjeta de bienvenida ────────────────── -->
            <VBox styleClass="welcome-card" spacing="14">
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-graduation-cap" iconSize="30" iconColor="#6c63ff"/>
                    <VBox spacing="3">
                        <Label text="Bienvenido capa 8!" styleClass="card-title"/>
                        <Label fx:id="lblFecha" text="..." styleClass="card-date"/>
                    </VBox>
                </HBox>

                <Separator/>

                <Label styleClass="welcome-description" wrapText="true"
                       text="Esta aplicación centraliza los conceptos clave aprendidos durante el curso de Probabilidad y Estadística. Utiliza el menú lateral para navegar entre los diferentes temas y acceder a los ejemplos interactivos. Cada sección presenta la definición del concepto, su fórmula o código de aplicación, y una demostración funcional donde puedes ingresar valores reales."/>

                <!-- Chips de información del alumno -->
                <HBox spacing="14">
                    <VBox styleClass="info-chip" spacing="3">
                        <Label text="ALUMNO" styleClass="chip-label"/>
                        <Label fx:id="lblNombreAlumno" text="..." styleClass="chip-value"/>
                    </VBox>
                    <VBox styleClass="info-chip" spacing="3">
                        <Label text="GRUPO" styleClass="chip-label"/>
                        <Label fx:id="lblGrupoAlumno" text="..." styleClass="chip-value"/>
                    </VBox>
                    <VBox styleClass="info-chip" spacing="3">
                        <Label text="SEMESTRE" styleClass="chip-label"/>
                        <Label fx:id="lblSemestre" text="..." styleClass="chip-value"/>
                    </VBox>
                    <VBox styleClass="info-chip-accent" spacing="3">
                        <Label text="TEMAS CUBIERTOS" styleClass="chip-label"/>
                        <Label fx:id="lblTotalTemas" text="1" styleClass="chip-value-accent"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ── Sección: Grid de temas ───────────────── -->
            <VBox spacing="14">
                <Label text="Temas del Portafolio" styleClass="section-title"/>

                <GridPane hgap="16" vgap="16">

                    <!-- Tarjeta Tema 1 (clickeable) -->
                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0"
                          styleClass="topic-card" spacing="10"
                          onMouseClicked="#abrirTema1">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <FontIcon iconLiteral="fas-dice" iconSize="20" iconColor="#6c63ff"/>
                            <Label text="Probabilidad Clásica" styleClass="topic-card-title"/>
                        </HBox>
                        <Label wrapText="true" styleClass="topic-card-desc"
                               text="Conceptos fundamentales de la probabilidad: espacio muestral, eventos y la regla de Laplace."/>
                        <HBox alignment="CENTER_RIGHT">
                            <Label text="Abrir  →" styleClass="topic-card-link"/>
                        </HBox>
                    </VBox>

                    <!-- Tarjeta Tema 2 (clickeable) -->
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="0"
                          styleClass="topic-card" spacing="10"
                          onMouseClicked="#abrirTema2">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <FontIcon iconLiteral="fas-random" iconSize="20" iconColor="#6c63ff"/>
                            <Label text="Baraja Española" styleClass="topic-card-title"/>
                        </HBox>
                        <Label wrapText="true" styleClass="topic-card-desc"
                               text="Programa #1. Devuelve una carta aleatoriamente del mazo de cartas Españolas."/>
                        <HBox alignment="CENTER_RIGHT">
                            <Label text="Abrir  →" styleClass="topic-card-link"/>
                        </HBox>
                    </VBox>

                    <!-- Tarjeta Placeholder (aparece hasta que agregues el Tema 2) -->
                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="1"
                          styleClass="topic-card-placeholder" spacing="10">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <FontIcon iconLiteral="fas-plus-circle" iconSize="20" iconColor="#d1d5db"/>
                            <Label text="Próximo Tema..." styleClass="topic-card-title-muted"/>
                        </HBox>
                        <Label wrapText="true" styleClass="topic-card-desc-muted"
                               text="Aquí aparecerá el siguiente tema que agregues al portafolio siguiendo los 3 pasos del README."/>
                    </VBox>

                    <!-- Restricción de columnas: 50% cada una -->
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                </GridPane>
            </VBox><!-- fin sección temas -->

        </VBox><!-- fin content-area -->
    </ScrollPane><!-- fin ScrollPane -->

</HBox>
