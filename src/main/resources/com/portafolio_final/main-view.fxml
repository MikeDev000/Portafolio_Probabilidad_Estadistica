<?xml version="1.0" encoding="UTF-8"?>

<!--
  ╔══════════════════════════════════════════════════════════════╗
  ║  main-view.fxml  —  Layout del Dashboard principal           ║
  ║                                                              ║
  ║  Ruta: resources/com/estadistica/portafolio/fxml/            ║
  ║                                                              ║
  ║  PARA AGREGAR UN TEMA AL MENÚ:                               ║
  ║    1. Busca la sección "ZONA DE TEMAS"                       ║
  ║    2. Descomenta o duplica el bloque <Button>                ║
  ║    3. Cambia el fx:id, el onAction y el texto del Label      ║
  ╚══════════════════════════════════════════════════════════════╝
-->

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<HBox minHeight="580" spacing="0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.portafolio_final.controller.MainController">

    <!-- ╔══════════════════════════════════════╗ -->
    <!-- ║           SIDEBAR IZQUIERDO          ║ -->
    <!-- ╚══════════════════════════════════════╝ -->
    <VBox maxWidth="262" minWidth="262" prefWidth="262" styleClass="sidebar">

        <!-- Cabecera: Logo + nombre de la materia -->
        <VBox alignment="CENTER" spacing="5" styleClass="sidebar-header">
            <padding><Insets bottom="22" left="20" right="20" top="28" /></padding>
            <FontIcon iconColor="#6c63ff" iconLiteral="fas-chart-pie" iconSize="38" />
            <Label styleClass="sidebar-title" text="Prob &amp; Estadística" />
            <Label styleClass="sidebar-subtitle" text="Conceptos clave" />
        </VBox>

        <Separator styleClass="sidebar-separator" />

        <!-- ── Sección GENERAL ──────────────────────────── -->
        <VBox spacing="3" styleClass="nav-section">
            <padding><Insets bottom="6" left="14" right="14" top="16" /></padding>
            <Label styleClass="nav-section-label" text="GENERAL" />

            <Button fx:id="btnInicio" maxWidth="Infinity" onAction="#mostrarInicio" styleClass="nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconColor="#8b8fa8" iconLiteral="fas-home" iconSize="15" />
                        <Label mouseTransparent="true" text="Inicio" />
                    </HBox>
                </graphic>
            </Button>
        </VBox>

        <!-- ── Sección TEMAS ────────────────────────────── -->
        <VBox spacing="3" styleClass="nav-section">
            <padding><Insets bottom="6" left="14" right="14" top="6" /></padding>
            <Label styleClass="nav-section-label" text="TEMAS" />

            <!-- ╔══════════════════════════════════════════════╗
                 ║  ZONA DE TEMAS  ←  Agrega tus botones aquí  ║
                 ║  Duplica el bloque <Button> por cada tema    ║
                 ╚══════════════════════════════════════════════╝ -->

            <!-- TEMA 1: Probabilidad Clásica (ejemplo incluido) -->
            <Button fx:id="btnTema1" maxWidth="Infinity" onAction="#abrirTema1" styleClass="nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconColor="#8b8fa8" iconLiteral="fas-dice" iconSize="15" />
                        <Label mouseTransparent="true" text="Prob. Clásica" />
                    </HBox>
                </graphic>
            </Button>

            <!-- TEMA 2 (plantilla comentada — descomenta y personaliza) -->
            <Button fx:id="btnTema2" maxWidth="Infinity" onAction="#abrirTema2" styleClass="nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconColor="#8b8fa8" iconLiteral="fas-random" iconSize="15" />
                        <Label mouseTransparent="true" text="P1 Barajas" />
                    </HBox>
                </graphic>
            </Button>


            <!-- TEMA 3: Regla Aditiva -->
            <Button fx:id="btnTema3" maxWidth="Infinity" onAction="#abrirTema3" styleClass="nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconColor="#8b8fa8" iconLiteral="fas-plus-circle" iconSize="15" />
                        <Label mouseTransparent="true" text="Regla Aditiva" />
                    </HBox>
                </graphic>
            </Button>

            <!-- NUEVOS TEMAS -->
            <Button fx:id="btnTema4" maxWidth="Infinity" onAction="#abrirTema4" styleClass="nav-button"><graphic><HBox alignment="CENTER_LEFT" spacing="10"><FontIcon iconColor="#8b8fa8" iconLiteral="fas-project-diagram" iconSize="15" /><Label mouseTransparent="true" text="Tipos Eventos" /></HBox></graphic></Button>
            <Button fx:id="btnTema5" maxWidth="Infinity" onAction="#abrirTema5" styleClass="nav-button"><graphic><HBox alignment="CENTER_LEFT" spacing="10"><FontIcon iconColor="#8b8fa8" iconLiteral="fas-filter" iconSize="15" /><Label mouseTransparent="true" text="Prob. Condic." /></HBox></graphic></Button>
            <Button fx:id="btnTema6" maxWidth="Infinity" onAction="#abrirTema6" styleClass="nav-button"><graphic><HBox alignment="CENTER_LEFT" spacing="10"><FontIcon iconColor="#8b8fa8" iconLiteral="fas-times" iconSize="15" /><Label mouseTransparent="true" text="Regla Mult." /></HBox></graphic></Button>
            <Button fx:id="btnTema7" maxWidth="Infinity" onAction="#abrirTema7" styleClass="nav-button"><graphic><HBox alignment="CENTER_LEFT" spacing="10"><FontIcon iconColor="#8b8fa8" iconLiteral="fas-layer-group" iconSize="15" /><Label mouseTransparent="true" text="Cartas (3ev)" /></HBox></graphic></Button>
            <Button fx:id="btnTema8" maxWidth="Infinity" onAction="#abrirTema8" styleClass="nav-button"><graphic><HBox alignment="CENTER_LEFT" spacing="10"><FontIcon iconColor="#8b8fa8" iconLiteral="fas-sitemap" iconSize="15" /><Label mouseTransparent="true" text="Prob. Total" /></HBox></graphic></Button>
            <Button fx:id="btnTema9" maxWidth="Infinity" onAction="#abrirTema9" styleClass="nav-button"><graphic><HBox alignment="CENTER_LEFT" spacing="10"><FontIcon iconColor="#8b8fa8" iconLiteral="fas-balance-scale" iconSize="15" /><Label mouseTransparent="true" text="T. Bayes" /></HBox></graphic></Button>
            <Button fx:id="btnTema10" maxWidth="Infinity" onAction="#abrirTema10" styleClass="nav-button"><graphic><HBox alignment="CENTER_LEFT" spacing="10"><FontIcon iconColor="#8b8fa8" iconLiteral="fas-chart-line" iconSize="15" /><Label mouseTransparent="true" text="Tendencia" /></HBox></graphic></Button>
            <Button fx:id="btnTema11" maxWidth="Infinity" onAction="#abrirTema11" styleClass="nav-button"><graphic><HBox alignment="CENTER_LEFT" spacing="10"><FontIcon iconColor="#8b8fa8" iconLiteral="fas-chart-area" iconSize="15" /><Label mouseTransparent="true" text="Dispersión" /></HBox></graphic></Button>

        </VBox>

        <!-- Separador flexible para empujar el footer hacia abajo -->
        <Region VBox.vgrow="ALWAYS" />

        <!-- Footer: datos del alumno -->
        <VBox spacing="0" styleClass="sidebar-footer">
            <padding><Insets bottom="20" left="20" right="20" top="0" /></padding>
            <Separator style="-fx-padding: 0 0 12 0;" styleClass="sidebar-separator" />
            <VBox spacing="3" style="-fx-padding: 14 0 0 0;">
                <Label styleClass="footer-label" text="Desarrollado por" />
                <Label fx:id="lblNombreSidebar" styleClass="footer-value" text="..." />
                <Label fx:id="lblGrupoSidebar" styleClass="footer-group" text="..." />
            </VBox>
        </VBox>

    </VBox><!-- fin sidebar -->


    <!-- ╔══════════════════════════════════════╗ -->
    <!-- ║         ÁREA DE CONTENIDO            ║ -->
    <!-- ╚══════════════════════════════════════╝ -->
    <ScrollPane fitToWidth="true" styleClass="content-scroll" HBox.hgrow="ALWAYS">
        <VBox spacing="22" styleClass="content-area">
            <padding><Insets bottom="40" left="40" right="40" top="36" /></padding>

            <!-- ── Encabezado de página ─────────────────── -->
            <VBox spacing="6">
                <Label styleClass="page-title" text="Dashboard" />
                <Label styleClass="page-subtitle" text="Todos los temas de probabilidad y estadística al alcance de un click." wrapText="true" />
            </VBox>

            <!-- ── Tarjeta de bienvenida ────────────────── -->
            <VBox spacing="14" styleClass="welcome-card">
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <FontIcon iconColor="#6c63ff" iconLiteral="fas-graduation-cap" iconSize="30" />
                    <VBox spacing="3">
                        <Label styleClass="card-title" text="Bienvenido capa 8!" />
                        <Label fx:id="lblFecha" styleClass="card-date" text="..." />
                    </VBox>
                </HBox>

                <Separator />

                <Label styleClass="welcome-description" text="Esta aplicación centraliza los conceptos clave aprendidos durante el curso de Probabilidad y Estadística. Utiliza el menú lateral para navegar entre los diferentes temas y acceder a los ejemplos interactivos. Cada sección presenta la definición del concepto, su fórmula o código de aplicación, y una demostración funcional donde puedes ingresar valores reales." wrapText="true" />

                <!-- Chips de información del alumno -->
                <HBox spacing="14">
                    <VBox spacing="3" styleClass="info-chip">
                        <Label styleClass="chip-label" text="ALUMNO" />
                        <Label fx:id="lblNombreAlumno" styleClass="chip-value" text="..." />
                    </VBox>
                    <VBox spacing="3" styleClass="info-chip">
                        <Label styleClass="chip-label" text="GRUPO" />
                        <Label fx:id="lblGrupoAlumno" styleClass="chip-value" text="..." />
                    </VBox>
                    <VBox spacing="3" styleClass="info-chip">
                        <Label styleClass="chip-label" text="SEMESTRE" />
                        <Label fx:id="lblSemestre" styleClass="chip-value" text="..." />
                    </VBox>
                    <VBox spacing="3" styleClass="info-chip-accent">
                        <Label styleClass="chip-label" text="TEMAS CUBIERTOS" />
                        <Label fx:id="lblTotalTemas" styleClass="chip-value-accent" text="1" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- ── Sección: Grid de temas ───────────────── -->
            <VBox spacing="14">
                <Label styleClass="section-title" text="Temas del Portafolio" />

                <GridPane hgap="16" vgap="16">

                    <!-- Tarjeta Tema 1 (clickeable) -->
                    <VBox onMouseClicked="#abrirTema1" spacing="10" styleClass="topic-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <FontIcon iconColor="#6c63ff" iconLiteral="fas-dice" iconSize="20" />
                            <Label styleClass="topic-card-title" text="Probabilidad Clásica" />
                        </HBox>
                        <Label styleClass="topic-card-desc" text="Conceptos fundamentales de la probabilidad: espacio muestral, eventos y la regla de Laplace." wrapText="true" />
                        <HBox alignment="CENTER_RIGHT">
                            <Label styleClass="topic-card-link" text="Abrir  →" />
                        </HBox>
                    </VBox>

                    <!-- Tarjeta Tema 2 (clickeable) -->
                    <VBox onMouseClicked="#abrirTema2" spacing="10" styleClass="topic-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <FontIcon iconColor="#6c63ff" iconLiteral="fas-random" iconSize="20" />
                            <Label styleClass="topic-card-title" text="Baraja Española" />
                        </HBox>
                        <Label styleClass="topic-card-desc" text="Programa #1. Devuelve una carta aleatoriamente del mazo de cartas Españolas." wrapText="true" />
                        <HBox alignment="CENTER_RIGHT">
                            <Label styleClass="topic-card-link" text="Abrir  →" />
                        </HBox>
                    </VBox>

                    <!-- Tarjeta Tema 3 (clickeable) -->
                    <VBox onMouseClicked="#abrirTema3" spacing="10" styleClass="topic-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <FontIcon iconColor="#6c63ff" iconLiteral="fas-plus-circle" iconSize="20" />
                            <Label styleClass="topic-card-title" text="Regla Aditiva" />
                        </HBox>
                        <Label styleClass="topic-card-desc" text="Cálculo de la probabilidad de la unión de 2, 3 o 4 eventos mediante el principio de inclusión-exclusión." wrapText="true" />
                        <HBox alignment="CENTER_RIGHT">
                            <Label styleClass="topic-card-link" text="Abrir  →" />
                        </HBox>
                    </VBox>

                    <!-- Tarjeta Tema 4 -->
                    <VBox onMouseClicked="#abrirTema4" spacing="10" styleClass="topic-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <HBox alignment="CENTER_LEFT" spacing="12"><FontIcon iconColor="#6c63ff" iconLiteral="fas-project-diagram" iconSize="20" /><Label styleClass="topic-card-title" text="Tipos de Eventos" /></HBox>
                        <Label styleClass="topic-card-desc" text="Identificación y cálculo de eventos compuestos, complementarios y disjuntos." wrapText="true" />
                    </VBox>

                    <!-- Tarjeta Tema 5 -->
                    <VBox onMouseClicked="#abrirTema5" spacing="10" styleClass="topic-card" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <HBox alignment="CENTER_LEFT" spacing="12"><FontIcon iconColor="#6c63ff" iconLiteral="fas-filter" iconSize="20" /><Label styleClass="topic-card-title" text="Prob. Condicional" /></HBox>
                        <Label styleClass="topic-card-desc" text="Cálculo de probabilidad a partir de tablas de contingencia y eventos condicionados." wrapText="true" />
                    </VBox>

                    <!-- Tarjeta Tema 6 -->
                    <VBox onMouseClicked="#abrirTema6" spacing="10" styleClass="topic-card" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <HBox alignment="CENTER_LEFT" spacing="12"><FontIcon iconColor="#6c63ff" iconLiteral="fas-times" iconSize="20" /><Label styleClass="topic-card-title" text="Regla Multiplicativa" /></HBox>
                        <Label styleClass="topic-card-desc" text="Extracción de elementos con o sin reemplazo (eventos independientes y dependientes)." wrapText="true" />
                    </VBox>

                    <!-- Tarjeta Tema 7 -->
                    <VBox onMouseClicked="#abrirTema7" spacing="10" styleClass="topic-card" GridPane.columnIndex="0" GridPane.rowIndex="3">
                        <HBox alignment="CENTER_LEFT" spacing="12"><FontIcon iconColor="#6c63ff" iconLiteral="fas-layer-group" iconSize="20" /><Label styleClass="topic-card-title" text="Juego 3 Eventos" /></HBox>
                        <Label styleClass="topic-card-desc" text="Aplicación de la regla multiplicativa en cascada para 3 extracciones de cartas." wrapText="true" />
                    </VBox>

                    <!-- Tarjeta Tema 8 -->
                    <VBox onMouseClicked="#abrirTema8" spacing="10" styleClass="topic-card" GridPane.columnIndex="1" GridPane.rowIndex="3">
                        <HBox alignment="CENTER_LEFT" spacing="12"><FontIcon iconColor="#6c63ff" iconLiteral="fas-sitemap" iconSize="20" /><Label styleClass="topic-card-title" text="Probabilidad Total" /></HBox>
                        <Label styleClass="topic-card-desc" text="Análisis de escenarios múltiples y cálculo de la probabilidad total de un evento." wrapText="true" />
                    </VBox>

                    <!-- Tarjeta Tema 9 -->
                    <VBox onMouseClicked="#abrirTema9" spacing="10" styleClass="topic-card" GridPane.columnIndex="0" GridPane.rowIndex="4">
                        <HBox alignment="CENTER_LEFT" spacing="12"><FontIcon iconColor="#6c63ff" iconLiteral="fas-balance-scale" iconSize="20" /><Label styleClass="topic-card-title" text="Teorema de Bayes" /></HBox>
                        <Label styleClass="topic-card-desc" text="Reversión de condicionalidad: cálculo de la probabilidad a posteriori de una causa." wrapText="true" />
                    </VBox>

                    <!-- Tarjeta Tema 10 -->
                    <VBox onMouseClicked="#abrirTema10" spacing="10" styleClass="topic-card" GridPane.columnIndex="1" GridPane.rowIndex="4">
                        <HBox alignment="CENTER_LEFT" spacing="12"><FontIcon iconColor="#6c63ff" iconLiteral="fas-chart-line" iconSize="20" /><Label styleClass="topic-card-title" text="Tendencia Central" /></HBox>
                        <Label styleClass="topic-card-desc" text="Cálculo automático de la Media, Mediana y Moda a partir de un conjunto de datos." wrapText="true" />
                    </VBox>

                    <!-- Tarjeta Tema 11 -->
                    <VBox onMouseClicked="#abrirTema11" spacing="10" styleClass="topic-card" GridPane.columnIndex="0" GridPane.rowIndex="5">
                        <HBox alignment="CENTER_LEFT" spacing="12"><FontIcon iconColor="#6c63ff" iconLiteral="fas-chart-area" iconSize="20" /><Label styleClass="topic-card-title" text="Dispersión" /></HBox>
                        <Label styleClass="topic-card-desc" text="Cálculo de la Varianza y Desviación Estándar poblacional y muestral." wrapText="true" />
                    </VBox>

                    <!-- Tarjeta Placeholder -->
                    <VBox spacing="10" styleClass="topic-card-placeholder" GridPane.columnIndex="1" GridPane.rowIndex="5">
                        <HBox alignment="CENTER_LEFT" spacing="12"><FontIcon iconColor="#d1d5db" iconLiteral="fas-plus-circle" iconSize="20" /><Label styleClass="topic-card-title-muted" text="Fin del Portafolio" /></HBox>
                        <Label styleClass="topic-card-desc-muted" text="Esperando a agregar más temas..." wrapText="true" />
                    </VBox>

                    <!-- Restricción de columnas: 50% cada una -->
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>

                </GridPane>
            </VBox><!-- fin sección temas -->

        </VBox><!-- fin content-area -->
    </ScrollPane><!-- fin ScrollPane -->

</HBox>
